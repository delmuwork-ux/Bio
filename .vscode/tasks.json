{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Dev Server",
      "type": "shell",
      "command": "\"C:\\Program Files\\nodejs\\npm.cmd\"",
      "args": ["run", "dev"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Starting.*",
          "endsPattern": "^.*listening.*"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "Install Dependencies",
      "type": "shell",
      "command": "\"C:\\Program Files\\nodejs\\npm.cmd\"",
      "args": ["install"]
    },
    {
      "label": "Build Project",
      "type": "shell",
      "command": "\"C:\\Program Files\\nodejs\\npm.cmd\"",
      "args": ["run", "build"]
    },
    {
      "label": "Run Linter",
      "type": "shell",
      "command": "\"C:\\Program Files\\nodejs\\npm.cmd\"",
      "args": ["run", "lint"]
    }
  ]
}
